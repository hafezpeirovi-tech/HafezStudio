{
  "manifestVersion": 5,
  "id": "ir.hafez.studio.premiere",
  "name": "Hafez Studio Finisher",
  "version": "0.3.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "localFileSystem": "request"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "hafezFinisher",
      "label": {
        "default": "Hafez Finisher"
      },
      "minimumSize": {
        "width": 300,
        "height": 360
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 620
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 680
      }
    }
  ]
}
